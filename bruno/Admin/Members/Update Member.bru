meta {
  name: Update Member
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/admin/members/{{memberId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "name": "Alice Reader",
    "email": "alice@example.com",
    "active": true,
    "regenerateCode": false
  }
}
