meta {
  name: Create Admin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/admin/users/create-admin
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "name": "Assistant Librarian",
    "email": "assistant@library.local",
    "password": "change-me-123"
  }
}

vars:pre-request {
  baseUrl: http://localhost:8080
}
