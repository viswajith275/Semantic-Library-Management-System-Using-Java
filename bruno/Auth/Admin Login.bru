meta {
  name: Admin Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/admin/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

vars:pre-request {
  baseUrl: http://localhost:8080
}

script:post-response {
  bru.setVar("adminToken", res.body.token);
}
