<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<!-- Shared top bar. Keep page-specific controls out of this component. -->
<HBox alignment="CENTER_LEFT"
      prefHeight="68"
      spacing="16"
      styleClass="app-topbar"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.slms.controllers.TopBarController">
    <padding>
        <Insets top="0" right="28" bottom="0" left="28" />
    </padding>

    <Pane HBox.hgrow="ALWAYS" />

    <Button mnemonicParsing="false" onAction="#toggleTheme" styleClass="top-icon-button" accessibleText="Toggle theme">
        <graphic>
            <!-- Lucide moon/sun -->
            <SVGPath fx:id="themeIcon" content="M12 3a6.9 6.9 0 0 0 9 9c-1.04 5.46-6.22 9.1-11.65 7.7A9 9 0 1 1 12 3" styleClass="top-icon" />
        </graphic>
    </Button>
    <Button fx:id="notificationButton" mnemonicParsing="false" onAction="#openNotifications" styleClass="top-icon-button" accessibleText="My wishlist">
        <graphic>
            <!-- Lucide heart -->
            <SVGPath content="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z" styleClass="top-icon" />
        </graphic>
    </Button>

    <Separator orientation="VERTICAL" prefHeight="28" styleClass="topbar-separator" />

    <Label fx:id="avatar" text="U" styleClass="avatar" />
    <VBox alignment="CENTER_LEFT" prefHeight="36" maxHeight="36" spacing="1" styleClass="profile-details">
        <!-- Bind these labels to the signed-in user later. -->
        <Label fx:id="profileName" text="Library User" styleClass="profile-name" />
        <Label fx:id="profileRole" text="User" styleClass="profile-role" />
    </VBox>
</HBox>
