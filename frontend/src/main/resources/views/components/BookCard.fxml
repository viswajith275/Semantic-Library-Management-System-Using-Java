<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.shape.Rectangle?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.slms.controllers.BookCardController" styleClass="book-card">
    <VBox spacing="10" styleClass="book-card-details">
        <padding><Insets top="14" right="14" bottom="12" left="14"/></padding>
        <HBox spacing="13" alignment="TOP_LEFT">
            <StackPane styleClass="book-cover" minWidth="78" prefWidth="78" maxWidth="78" minHeight="112" prefHeight="112" maxHeight="112">
                <VBox spacing="5" alignment="CENTER" styleClass="cover-fallback" >
                    <padding><Insets top="6" right="6" bottom="6" left="6"/></padding>
                    <Label fx:id="fallbackTitle" wrapText="true" styleClass="cover-fallback-title"/>
                    <Label fx:id="fallbackAuthor" wrapText="true" styleClass="cover-fallback-author"/>
                </VBox>
                <ImageView fx:id="coverImage" fitWidth="78" fitHeight="112" preserveRatio="false"/>
            </StackPane>
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <HBox><Label fx:id="stock" styleClass="stock-available"/></HBox>
                <Label fx:id="title" wrapText="true" styleClass="book-title"/>
                <Label fx:id="author" wrapText="true" styleClass="book-author"/>
                <Label fx:id="isbn" styleClass="book-isbn"/>
            </VBox>
        </HBox>
        <HBox spacing="6">
            <Label fx:id="genre" styleClass="book-tag"/><Label fx:id="year" styleClass="book-tag"/><Label fx:id="copies" styleClass="book-tag"/>
        </HBox>
        <VBox fx:id="barcodeSection" spacing="5" visible="false" managed="false" styleClass="book-barcode-section">
            <Label text="COPY BARCODES" styleClass="book-barcode-caption"/>
            <FlowPane fx:id="barcodeList" hgap="5" vgap="5" prefWrapLength="240"/>
        </VBox>
    </VBox>
    <Separator/>
    <HBox spacing="19" alignment="CENTER_LEFT" styleClass="book-card-actions">
        <padding><Insets top="10" right="14" bottom="10" left="14"/></padding>
        <Button fx:id="viewButton" text="View" graphicTextGap="7" styleClass="book-action"><graphic><SVGPath content="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" styleClass="book-action-icon"/></graphic></Button>
        <Button fx:id="editButton" text="Edit" graphicTextGap="7" styleClass="book-action"><graphic><SVGPath content="M12 20h9 M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z" styleClass="book-action-icon"/></graphic></Button>
        <Button fx:id="deleteButton" text="" accessibleText="Delete book" graphicTextGap="7" styleClass="book-action-delete"><graphic><SVGPath content="M3 6h18 M8 6V4h8v2m3 0-1 14H6L5 6m5 4v6m4-6v6" styleClass="book-action-icon"/></graphic></Button>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="borrowButton" text="Borrow" graphicTextGap="7" styleClass="book-borrow-button"><graphic><SVGPath content="M12 5v14m-7-7h14" styleClass="book-action-icon"/></graphic></Button>
        <Button fx:id="interestButton" text="I’m interested" graphicTextGap="7" styleClass="book-interest-button"><graphic><SVGPath content="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9m-8 13h4" styleClass="book-action-icon"/></graphic></Button>
    </HBox>
</VBox>
