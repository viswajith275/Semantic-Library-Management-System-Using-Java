<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.slms.controllers.NotificationCardController"
      spacing="16" alignment="CENTER_LEFT" styleClass="notification-card">
    <padding>
        <Insets top="16" right="20" bottom="16" left="20"/>
    </padding>

    <StackPane fx:id="iconBox" styleClass="notification-icon-box">
        <SVGPath fx:id="icon" content="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" styleClass="notification-icon"/>
    </StackPane>

    <VBox spacing="4" HBox.hgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label fx:id="title" styleClass="notification-card-title"/>
            <Label fx:id="badge" text="NEW" styleClass="notification-new-badge" visible="false" managed="false"/>
        </HBox>
        <Label fx:id="message" wrapText="true" styleClass="notification-card-message"/>
        <Label fx:id="time" styleClass="notification-card-time"/>
    </VBox>
</HBox>
