<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.slms.controllers.BookCatalogController">
    <BorderPane styleClass="catalog-wrapper">
      <center>
        <VBox spacing="20" styleClass="catalog-page">
            <padding><Insets top="30" right="32" bottom="30" left="32"/></padding>
            <HBox spacing="16" alignment="BOTTOM_LEFT">
                <VBox spacing="6">
                    <Label fx:id="eyebrow" text="BROWSE THE SHELF" styleClass="catalog-eyebrow"/>
                    <Label text="Books" styleClass="catalog-title"/>
                    <Label fx:id="subtitle" text="Search the shelf in plain language, filter by genre or author, and borrow in one tap." styleClass="catalog-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="addBook" text="＋  Add Book" onAction="#openCreateDialog" styleClass="catalog-primary-button"/>
                <Button fx:id="borrowings" text="⇄  My borrowings" styleClass="catalog-secondary-button"/>
            </HBox>
            <StackPane fx:id="filterOverlay" alignment="TOP_LEFT">
                <VBox spacing="8" styleClass="catalog-filters">
                    <HBox spacing="9" alignment="TOP_LEFT">
                        <TextField fx:id="searchField" promptText="⌕   Search books by title, author or topic, then press Enter" styleClass="catalog-search" HBox.hgrow="ALWAYS"/>
                        <VBox minWidth="152" prefWidth="152" maxWidth="152" alignment="TOP_RIGHT">
                            <MenuButton fx:id="statusTrigger" text="Any status" styleClass="catalog-status-trigger" minWidth="152" prefWidth="152" maxWidth="152" minHeight="48" prefHeight="48" maxHeight="48">
                                <items>
                                    <MenuItem text="Any status" onAction="#selectStatus"/>
                                    <MenuItem text="Available" onAction="#selectStatus"/>
                                    <MenuItem text="Sold out" onAction="#selectStatus"/>
                                </items>
                            </MenuButton>
                        </VBox>
                    </HBox>
                    <Label fx:id="resultCount" text="▽  12 of 12 titles" styleClass="catalog-result-count"/>
                </VBox>
            </StackPane>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="catalog-scroll" VBox.vgrow="ALWAYS">
                <StackPane fx:id="bookContent" alignment="TOP_LEFT">
                <GridPane fx:id="bookGrid" hgap="14" vgap="14" styleClass="book-grid">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/><ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/><ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                    </columnConstraints>
                </GridPane>
                <Label fx:id="emptyState" text="No books found. Try another search." visible="false" managed="false" styleClass="catalog-empty-state"/>
                <Label fx:id="loadError" visible="false" managed="false" wrapText="true" styleClass="catalog-load-error"/>
                </StackPane>
            </ScrollPane>
        </VBox>
      </center>
    </BorderPane>
    <StackPane fx:id="createOverlay" visible="false" managed="false" styleClass="create-book-overlay" onMouseClicked="#createOverlayClicked">
        <VBox fx:id="createDialog" spacing="12" maxWidth="560" maxHeight="-Infinity" prefWidth="560" styleClass="create-book-dialog" onMouseClicked="#createDialogClicked">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Add a book to the catalogue" styleClass="create-book-title"/>
                    <Label text="Complete the backend catalogue fields." wrapText="true" styleClass="create-book-subtitle"/>
                </VBox>
                <Button text="×" onAction="#closeCreateDialog" styleClass="create-book-close" accessibleText="Close"/>
            </HBox>
            <VBox spacing="6">
                <Label text="Title" styleClass="create-book-field-label"/>
                <TextField fx:id="newTitle" promptText="e.g. Structure and Interpretation of Computer Programs" styleClass="create-book-input"/>
            </VBox>
            <GridPane hgap="16" vgap="12">
                <columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints>
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Author" styleClass="create-book-field-label"/>
                    <TextField fx:id="newAuthor" promptText="Author name" styleClass="create-book-input"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="ISBN" styleClass="create-book-field-label"/>
                    <TextField fx:id="newIsbn" promptText="978-..." styleClass="create-book-input"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="Cover color" styleClass="create-book-field-label"/>
                    <TextField fx:id="newColor" promptText="e.g. Navy blue" styleClass="create-book-input"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="Shelf location" styleClass="create-book-field-label"/>
                    <TextField fx:id="newShelf" promptText="Aisle 3, Shelf B" styleClass="create-book-input"/>
                </VBox>
            </GridPane>
            <VBox spacing="5"><Label text="Summary" styleClass="create-book-field-label"/><TextArea fx:id="newSummary" promptText="Short description" prefRowCount="2" wrapText="true" styleClass="create-book-input"/></VBox>
            <VBox spacing="5"><Label text="Characters / key concepts" styleClass="create-book-field-label"/><TextArea fx:id="newCharacters" promptText="Optional" prefRowCount="2" wrapText="true" styleClass="create-book-input"/></VBox>
            <VBox spacing="5"><Label text="Initial copy barcodes (comma separated)" styleClass="create-book-field-label"/><TextField fx:id="newBarcodes" promptText="BC-0001, BC-0002" styleClass="create-book-input"/></VBox>
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Label fx:id="createError" visible="false" managed="false" styleClass="create-book-error" HBox.hgrow="ALWAYS"/>
                <Button text="Save book" onAction="#saveBook" styleClass="catalog-primary-button"/>
            </HBox>
        </VBox>
    </StackPane>
</StackPane>
