<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.slms.controllers.NotificationsController"
      spacing="24" styleClass="notifications-page">
    <padding>
        <Insets top="32" right="40" bottom="40" left="40"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="16">
        <Button text="←  Back" onAction="#goBack" styleClass="catalog-secondary-button"/>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="6">
            <Label text="YOUR COLLECTION" styleClass="catalog-eyebrow"/>
            <Label text="My Wishlist" styleClass="catalog-title"/>
            <Label text="Books you’ve saved, with their latest availability." styleClass="catalog-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Refresh wishlist" onAction="#refresh" styleClass="catalog-secondary-button"/>
    </HBox>

    <VBox spacing="12">
        <HBox alignment="CENTER_LEFT">
            <Label text="Saved books" styleClass="section-heading"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="unreadCount" text="0 unread" styleClass="section-subcount"/>
        </HBox>
        <VBox fx:id="notificationsList" spacing="10"/>
        <VBox fx:id="emptyState" spacing="8" alignment="CENTER" styleClass="empty-state-container" visible="false" managed="false">
            <StackPane styleClass="notification-empty-icon-box">
                <SVGPath content="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z" styleClass="notification-empty-icon"/>
            </StackPane>
            <Label text="Your wishlist is empty" styleClass="empty-state-title"/>
            <Label text="Choose “Add to wishlist” on any book to save it here." styleClass="empty-state-subtitle"/>
        </VBox>
        <Label fx:id="statusMessage" visible="false" managed="false" wrapText="true" styleClass="status-message status-message-error"/>
    </VBox>
</VBox>
