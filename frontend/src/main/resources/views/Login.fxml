<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.slms.controllers.LoginController"
           styleClass="login-page">
    <VBox prefWidth="440" maxWidth="440" maxHeight="-Infinity" spacing="0" styleClass="login-form">
        <HBox alignment="CENTER_LEFT" spacing="11" styleClass="brand-lockup">
            <Label text="▥" styleClass="logo-mark" />
            <VBox spacing="1">
                <Label text="SLMS" styleClass="logo-name" />
                <Label text="Semantic Library Management System" styleClass="logo-caption" />
            </VBox>
        </HBox>

        <Region prefHeight="38" />

        <VBox fx:id="clientForm" spacing="0">
            <Label text="Welcome to your" styleClass="login-title" />
            <Label text="library." styleClass="login-title-accent" />
            <Label text="Enter the access code provided by your librarian." styleClass="login-subtitle" wrapText="true" />
            <Region prefHeight="30" />
            <Label text="Library access code" styleClass="field-label" />
            <TextField promptText="Enter your login code" styleClass="login-input" />
            <Region prefHeight="22" />
            <Button text="Continue to library  →" onAction="#signIn" maxWidth="1.7976931348623157E308" styleClass="sign-in-button" />
            <Region prefHeight="20" />
            <HBox alignment="CENTER" spacing="3">
                <Label text="Are you a librarian?" styleClass="signup-copy" />
                <Hyperlink text="Librarian sign in" onAction="#showLibrarianLogin" styleClass="signup-link" />
            </HBox>
        </VBox>

        <VBox fx:id="librarianForm" spacing="0" visible="false" managed="false">
            <Label text="Librarian sign in" styleClass="login-title" />
            <Label text="Manage your library." styleClass="login-title-accent" />
            <Label text="Sign in with the staff credentials provided to you." styleClass="login-subtitle" wrapText="true" />
            <Region prefHeight="26" />
            <Label text="Email address" styleClass="field-label" />
            <TextField promptText="you@slms.edu" styleClass="login-input" />
            <Region prefHeight="14" />
            <Label text="Password" styleClass="field-label" />
            <PasswordField promptText="Enter your password" styleClass="login-input" />
            <Region prefHeight="22" />
            <Button text="Sign in to dashboard  →" onAction="#signIn" maxWidth="1.7976931348623157E308" styleClass="sign-in-button" />
            <Region prefHeight="18" />
            <HBox alignment="CENTER" spacing="3">
                <Label text="Not a librarian?" styleClass="signup-copy" />
                <Hyperlink text="Enter a library code" onAction="#showClientLogin" styleClass="signup-link" />
            </HBox>
        </VBox>
    </VBox>
</StackPane>
